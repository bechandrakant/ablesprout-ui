# Base URL of the AbleSprout API (without /api/v1). Used by the browser for data calls.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: URL the Next.js server uses to reach the API (defaults to NEXT_PUBLIC_API_URL).
# API_URL=http://localhost:4000

# Shared with the API's PROXY_SHARED_SECRET so per-IP login rate limits see the real client IP.
PROXY_SHARED_SECRET=change-me-shared-proxy-secret

# Optional: where "Become a pilot school" submissions are POSTed as JSON
# (Slack/Zapier/Make/Formspree webhook). If unset they are written to the server log.
# PILOT_WEBHOOK_URL=
